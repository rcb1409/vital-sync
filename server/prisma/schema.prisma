// -------------------------------------------------------
// Prisma Schema — VitalSync Database
// -------------------------------------------------------
// Tables kept after the health-sync refactor:
//   User, NutritionLog, BodyMetric,
//   GoogleHealthAccount, HealthDataPoint,
//   ProactiveInsight, HealthSummary
//
// Removed: Exercise, WorkoutTemplate, DailyHabit,
//          StravaAccount, RunActivity
// Workout + sleep data now comes from Google Health.
//
// To apply changes:
//   npx prisma migrate dev --name description_of_change
//   npx prisma generate  (regenerates the client types)
// -------------------------------------------------------

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// =====================================================
// USERS
// =====================================================
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  goals        Json?    // { calorie_target, protein_target, target_weight }
  aiMemory     Json?    @default("[]") @map("ai_memory")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  nutritionLogs       NutritionLog[]
  bodyMetrics         BodyMetric[]
  googleHealthAccount GoogleHealthAccount?  // one-to-one, optional
  healthDataPoints    HealthDataPoint[]     // all Google Health data points for this user
  proactiveInsights   ProactiveInsight[]    // all AI-generated insights for this user
  healthSummaries     HealthSummary[]       // pre-computed weekly + monthly health summaries

  @@map("users")
}

// =====================================================
// NOTE: Exercise, WorkoutTemplate, DailyHabit,
// StravaAccount, and RunActivity were removed.
// Workout + sleep data now comes from Google Health.
// =====================================================

// =====================================================
// NUTRITION LOGS
// =====================================================
enum MealType {
  breakfast
  lunch
  dinner
  snack
}

model NutritionLog {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  foodName    String   @map("food_name")
  calories    Int
  proteinG    Decimal  @map("protein_g") @db.Decimal(6, 2)
  carbsG      Decimal  @map("carbs_g") @db.Decimal(6, 2)
  fatG        Decimal  @map("fat_g") @db.Decimal(6, 2)
  mealType    MealType @map("meal_type")
  isSavedMeal Boolean  @default(false) @map("is_saved_meal")
  date        DateTime @db.Date

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("nutrition_logs")
}

// =====================================================
// BODY METRICS (weight tracking)
// =====================================================
model BodyMetric {
  id       String   @id @default(uuid())
  userId   String   @map("user_id")
  weightKg Decimal  @map("weight_kg") @db.Decimal(5, 2)
  date     DateTime @db.Date

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date(sort: Desc)])
  @@map("body_metrics")
}

// =====================================================
// GOOGLE HEALTH ACCOUNTS (OAuth tokens)
// Mirrors StravaAccount — one-to-one with User.
// Stores the credentials needed to call the Google
// Fitness REST API on behalf of this user.
// =====================================================
model GoogleHealthAccount {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")          // one user = one Google account
  googleAccountId String   @map("google_account_id")        // Google's sub/account identifier (OAuth sub claim)
  healthUserId    String?  @unique @map("health_user_id")   // Google Health API user ID (e.g. "3624987878597428517")
                                                            // Used to map webhook notifications back to our user
  accessToken     String   @map("access_token") @db.Text    // short-lived (1 hr)
  refreshToken    String   @map("refresh_token") @db.Text   // long-lived, used to get new access tokens
  tokenExpiresAt  DateTime @map("token_expires_at")         // when the access_token stops working
  lastSyncAt      DateTime? @map("last_sync_at")            // when we last pulled data
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("google_health_accounts")
}

// =====================================================
// HEALTH DATA POINTS
// One row per data reading from Google Fitness API.
// Stores exercise sessions, heart rate, sleep, steps.
// one-to-many with User (via userId FK — NOT named on User model).
// =====================================================
model HealthDataPoint {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  dataType   String   @map("data_type")  // "exercise", "heart_rate", "sleep", "steps"
  value      Json                         // flexible: { activityType, steps, durationMinutes, ... }
  recordedAt DateTime @map("recorded_at") // when the activity/reading actually happened
  source           String   @default("google_health") // "google_health" for now; extensible later
  googleDataPointId String? @unique @map("google_data_point_id") // dedup: prevent re-processing the same Google Health data point
  createdAt        DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dataType, recordedAt(sort: Desc)])
  @@map("health_data_points")
}

// =====================================================
// PROACTIVE INSIGHTS
// AI-generated insights triggered by health events
// (e.g., post-workout analysis). Displayed on dashboard.
// one-to-many with User (via userId FK — NOT named on User model).
// =====================================================
model ProactiveInsight {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  type         String   @default("post_activity") // "post_activity" | "daily_summary" | etc.
  severity     String   @default("info")           // "info" | "warning" | "alert"
  title        String                               // e.g., "Post-Walk Insight"
  message      String   @db.Text                   // the AI-generated text
  dataSnapshot Json     @map("data_snapshot")      // activity + context that triggered it (for debugging)
  isRead       Boolean  @default(false) @map("is_read")
  isDismissed  Boolean  @default(false) @map("is_dismissed")
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@map("proactive_insights")
}

// =====================================================
// HEALTH SUMMARIES (Pre-computed rolling averages)
// Two rows per user: "weekly" (7-day) and "monthly" (30-day).
// Updated incrementally on each new data point — NOT
// recomputed from scratch. This is what the AI coach
// reads for context instead of querying raw data.
// =====================================================
model HealthSummary {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  window    String   // "weekly" or "monthly"
  updatedAt DateTime @updatedAt @map("updated_at")

  // ── Sleep metrics ──────────────────────────────────
  sleepAvgMinutes   Float @default(0) @map("sleep_avg_minutes")
  sleepAvgDeep      Float @default(0) @map("sleep_avg_deep")
  sleepAvgRem       Float @default(0) @map("sleep_avg_rem")
  sleepDataCount    Int   @default(0) @map("sleep_data_count")
  sleepTrend        String @default("STABLE") @map("sleep_trend")  // IMPROVING | DECLINING | STABLE
  sleepRecentValues Json   @default("[]") @map("sleep_recent_values")  // last N totals for sliding window

  // ── Exercise metrics ───────────────────────────────
  workoutCount       Int   @default(0) @map("workout_count")
  workoutAvgDuration Float @default(0) @map("workout_avg_duration") // minutes
  workoutAvgCalories Float @default(0) @map("workout_avg_calories")
  restDayStreak      Int   @default(0) @map("rest_day_streak")
  trainingDayStreak  Int   @default(0) @map("training_day_streak")
  workoutTypes       Json  @default("{}") @map("workout_types")  // { "RUNNING": 5, "CYCLING": 2 }

  // ── Recovery metrics (NEW) ─────────────────────────
  avgHRV              Float  @default(0) @map("avg_hrv")              // HRV RMSSD in ms
  avgRestingHR        Float  @default(0) @map("avg_resting_hr")       // Resting HR in bpm
  latestRecoveryScore Int    @default(0) @map("latest_recovery_score") // 0-100 recovery score
  recoveryTrend       String @default("STABLE") @map("recovery_trend") // IMPROVING | DECLINING | STABLE
  hrvRecentValues     Json   @default("[]") @map("hrv_recent_values")  // last N HRV values for trend
  rhrRecentValues     Json   @default("[]") @map("rhr_recent_values")  // last N RHR values for trend

  // ── Activity metrics (NEW) ─────────────────────────
  avgDailySteps       Int    @default(0) @map("avg_daily_steps")      // Average steps per day
  latestVO2Max        Float  @default(0) @map("latest_vo2_max")       // Most recent VO2 Max
  vo2MaxTrend         String @default("STABLE") @map("vo2_max_trend") // IMPROVING | DECLINING | STABLE
  stepsRecentValues   Json   @default("[]") @map("steps_recent_values") // last N daily step counts

  // ── Computed scores (NEW) ──────────────────────────
  avgSleepScore       Float @default(0) @map("avg_sleep_score")       // Average sleep score (0-100)
  weeklyTrainingLoad  Json  @default("{}") @map("weekly_training_load") // { totalMinutes, totalCalories, intensityScore, ... }

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, window])
  @@map("health_summaries")
}

